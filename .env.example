NODE_ENV=production

# HTTP Server
HTTP_PORT=4000
HTTP_HOST="http://localhost:4000"
HTTP_CORS="http://localhost:3000"

# GRPC clients
AUTH_GRPC_URL="localhost:50052"

# Cookies
# Leave empty when the web client and this API are on different hosts
# (for example the Railway URLs): no Domain attribute is set.
# Set the shared parent domain when both share one, for example ".example.com".
COOKIES_DOMAIN=""
COOKIES_SECRET="your-secret-key"
